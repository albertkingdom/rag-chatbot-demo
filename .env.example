# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Required for embeddings ---
OPENAI_API_KEY=sk-proj-your-openai-key

# --- Required for vector store ---
PINECONE_API_KEY=pcsk-your-pinecone-key

# --- Required for chat/generation via OpenRouter (Gemini 2.5 Flash) ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# --- Optional: LangSmith tracing ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key
LANGCHAIN_PROJECT="your-project-name"

# --- Access control (see src/access_control.py) ---
# Shared API key required in X-API-Key header / login form. Leave unset to
# disable auth for local dev (AUTH_ENABLED still defaults to true).
APP_API_KEY=your-app-api-key
AUTH_ENABLED=true
RATE_LIMIT_RPM=60
SESSION_TTL_SECONDS=86400
