# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Required for embeddings ---
OPENAI_API_KEY=sk-proj-your-openai-key

# --- Required for vector store ---
PINECONE_API_KEY=pcsk-your-pinecone-key
# Index used by chat and manual sync (default rag-demo-qa-index, created on the
# first sync). Sync deletes vectors that are not in the uploaded manuals, so
# never point this at an index another deployment uses.
# PINECONE_INDEX_NAME=rag-demo-qa-index

# --- Required for chat/generation via OpenRouter (Gemini 2.5 Flash) ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# --- Optional: LangSmith tracing ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key
LANGCHAIN_PROJECT="your-project-name"

# --- Access control (see src/access_control.py) ---
# Shared API key required in X-API-Key header / login form. Leave unset to
# disable auth for local dev (AUTH_ENABLED still defaults to true).
APP_API_KEY=your-app-api-key
AUTH_ENABLED=true
RATE_LIMIT_RPM=60
SESSION_TTL_SECONDS=86400

# --- React frontend / upload API ---
# 25 MiB. The server still validates extension and declared content type.
MAX_UPLOAD_BYTES=26214400
# Optional canonical origin for cookie-authenticated CSRF checks when a proxy
# rewrites Host or scheme, for example https://rag.example.com.
APP_PUBLIC_ORIGIN=

# --- Hybrid retrieval ---
# Minimum seconds between checks for a BM25 index rebuilt by the sync job.
BM25_RELOAD_INTERVAL_SECONDS=30

# --- Semantic cache ---
# Max entries kept in the cache index; a lookup compares all of them. Integer >= 1;
# unset or invalid falls back to 50 (invalid values log a warning). Not yet passed
# through docker-compose.yml or Terraform, so production keeps the default.
CACHE_MAX_ENTRIES=50

# --- Short-term conversation history ---
CHAT_HISTORY_TTL_SECONDS=1800
CHAT_HISTORY_MAX_TURNS=3
